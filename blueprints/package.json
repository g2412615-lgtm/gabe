{
  "name": "kwe-blueprints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "mupdf": "1.28.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
